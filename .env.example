# Game API Configuration
API_BASE_URL="https://oldprison-prod.luckygem.online"
BOT_USERNAME="oldprison_bot"
WEBAPP_URL="https://oldprison-prod.luckygem.online/"

# Telegram MTProto Credentials (from https://my.telegram.org)
TG_API_ID=12345678
TG_API_HASH="0123456789abcdef0123456789abcdef"
TG_PHONE="+79991234567"
TG_SESSION_PATH="storage/user_session"

# Database Configuration
DB_URL="sqlite+aiosqlite:///storage/prison_bot.db"

# Client Emulation Settings
CLIENT_PLATFORM="web"
CLIENT_LANGUAGE="ru"
CLIENT_COUNTRY="RU"

# Scheduler & Timing Settings
ROUTINE_INTERVAL_MINUTES=15
JITTER_MIN_SEC=1.5
JITTER_MAX_SEC=4.0

# Business & Boss Settings
BUSINESS_COLLECT_MIN_MINUTES=480
BOSS_INTERVAL_MINUTES=10
BOSS_ALLOW_PAID_WEAPONS=False

# Prison & Energy Settings
PRISON_INTERVAL_MINUTES=20
PRISON_MIN_ENERGY=10
PRISON_TARGET_ID=0
PRISON_PREFER_NIGHT=False
PRISON_ALLOW_ENERGY_REFILL=False

# Telegram Management Bot
TG_BOT_TOKEN=""
ADMIN_TG_ID=0

# Social & Events Settings
SOCIAL_INTERVAL_MINUTES=30

# Web Dashboard & Mini App Server
WEB_HOST="0.0.0.0"
